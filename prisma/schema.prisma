generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PREPARING
  ON_THE_WAY
  DELIVERED
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  firstName  String
  lastName   String?
  username   String?
  phone      String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  ingredients String[] @default([])
  imageUrl    String
  oldPrice    Int?
  newPrice    Int
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json
  total     Int
  phone     String
  location  String
  latitude  Float?
  longitude Float?
  comment      String?
  status       OrderStatus @default(PENDING)
  courierName  String?
  courierPhone String?
  preparingAt  DateTime?
  onTheWayAt   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
}
